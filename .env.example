# Runtime reads environment variables; Bun also loads .env. Never commit real keys.
THE_ATLAS_DB=./data/the-atlas.sqlite
THE_ATLAS_HOST=127.0.0.1
THE_ATLAS_PORT=8787
THE_ATLAS_WORKER=true
# Natural-language mode is opt-in per source. Assertions mode needs no provider.
# THE_ATLAS_PROVIDER_API_KEY=
# THE_ATLAS_PROVIDER_BASE_URL=https://api.openai.com/v1
# THE_ATLAS_EXTRACTION_MODEL=gpt-4.1-mini
# THE_ATLAS_EMBEDDING_MODEL=text-embedding-3-small
# Atlas-native selective digestion (no CLI/app-server/Hermes inference/API-key fallback)
# THE_ATLAS_NATIVE_WORKER=true
# THE_ATLAS_CODEX_HOME=./data/oauth
# THE_ATLAS_EXTRACTION_MODEL=gpt-6-luna
# THE_ATLAS_CODEX_REASONING_EFFORT=low
# THE_ATLAS_JEV_API_KEY=
# THE_ATLAS_JEV_MODEL=jev-1.14.0
# THE_ATLAS_JEV_CONCURRENCY=4
