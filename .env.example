# Runtime reads environment variables; Bun also loads .env. Never commit real keys.
THREADATLAS_DB=./data/threadatlas.sqlite
THREADATLAS_HOST=127.0.0.1
THREADATLAS_PORT=8787
THREADATLAS_WORKER=true
# Natural-language mode is opt-in per source. Assertions mode needs no provider.
# THREADATLAS_PROVIDER_API_KEY=
# THREADATLAS_PROVIDER_BASE_URL=https://api.openai.com/v1
# THREADATLAS_EXTRACTION_MODEL=gpt-4.1-mini
# THREADATLAS_EMBEDDING_MODEL=text-embedding-3-small
