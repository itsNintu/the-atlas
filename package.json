{
  "name": "the-atlas",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "The Atlas: standalone source-linked graph/context memory for agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsNintu/the-atlas.git"
  },
  "homepage": "https://github.com/itsNintu/the-atlas#readme",
  "bugs": {
    "url": "https://github.com/itsNintu/the-atlas/issues"
  },
  "engines": {
    "bun": ">=1.2.21"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "cli": "bun src/cli.ts",
    "demo": "bun examples/workflow.ts",
    "check": "tsc --noEmit",
    "check:public": "bun scripts/check-public.ts",
    "test": "bun test tests",
    "test:e2e": "bun scripts/e2e.ts",
    "bench": "bun scripts/bench.ts",
    "provider:probe": "bun scripts/provider-probe.ts",
    "test:ui": "bun scripts/ui-test.ts",
    "build:cloudflare": "wrangler deploy --dry-run --outdir .private/cloudflare-dry-run",
    "deploy:cloudflare": "wrangler deploy --keep-vars"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@playwright/test": "1.55.1",
    "@types/bun": "1.4.4",
    "tiktoken": "1.0.22",
    "typescript": "5.9.2",
    "wrangler": "4.125.0"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.21"
  }
}
